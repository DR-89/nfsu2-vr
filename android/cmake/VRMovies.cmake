# Link the pinned FFmpeg media build produced by tools/build-vr-vp6.ps1.
function(nfsu2_vr_movies target platform)
    get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." ABSOLUTE)
    set(prefix "${root}/build/ffmpeg-${platform}")
    set(codec "${prefix}/libavcodec/libavcodec.a")
    set(util "${prefix}/libavutil/libavutil.a")
    set(format "${prefix}/libavformat/libavformat.a")
    set(resample "${prefix}/libswresample/libswresample.a")
    set(scale "${prefix}/libswscale/libswscale.a")
    if(NOT EXISTS "${codec}" OR NOT EXISTS "${util}" OR NOT EXISTS "${format}" OR NOT EXISTS "${resample}" OR NOT EXISTS "${scale}")
        message(FATAL_ERROR "Build the ${platform} media decoders with tools/build-vr-vp6.ps1 first.")
    endif()
    target_sources(${target} PRIVATE "${root}/src/movie_vp6.c")
    set_property(SOURCE "${root}/src/recomp_manual.c" APPEND PROPERTY COMPILE_DEFINITIONS NFSU2_NATIVE_VP6=1)
    set_property(SOURCE "${root}/src/movie_vp6.c" APPEND PROPERTY INCLUDE_DIRECTORIES "${prefix}" "${prefix}/src")
    add_library(nfsu2_vr_music STATIC "${root}/src/vr_music.cpp" "${root}/src/vr_media_decode.cpp")
    target_compile_features(nfsu2_vr_music PRIVATE cxx_std_17)
    target_include_directories(nfsu2_vr_music PUBLIC "${root}/src" "${root}/android/runtime" PRIVATE "${prefix}" "${prefix}/src")
    target_link_libraries(nfsu2_vr_music PRIVATE SDL2::SDL2 "${format}" "${codec}" "${resample}" "${scale}" "${util}")
    target_link_libraries(xbox_nv2a_vk PRIVATE nfsu2_vr_music)
    target_link_libraries(nfsu2_xr PRIVATE nfsu2_vr_music)
    target_link_libraries(${target} PRIVATE nfsu2_vr_music "${codec}" "${util}")
    if(ANDROID)
        # The static FFmpeg archives are private to the game. Its AArch64
        # assembly addresses lookup tables directly within this shared object.
        target_link_options(${target} PRIVATE "LINKER:--exclude-libs,libavcodec.a:libavutil.a:libavformat.a:libswresample.a:libswscale.a")
    endif()
    if(WIN32)
        target_compile_options(nfsu2_vr_music PRIVATE /EHsc)
        target_link_libraries(nfsu2_vr_music PRIVATE bcrypt ole32)
        target_link_libraries(${target} PRIVATE ole32 user32 bcrypt)
    endif()
endfunction()
